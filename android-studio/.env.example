# Android Studio Secrets & Cross-Platform Backend Configuration
# Copy this file to .env (ignored by git) and customize for your device or cloud backend.

# Emulator -> host machine localhost: http://10.0.2.2:3000
# Physical Android device -> host machine LAN IP: http://192.168.1.x:3000
# Cloud / AI Studio backend: https://your-cloud-run-url
API_BASE_URL=http://10.0.2.2:3000
GEMINI_API_KEY=your_api_key_here
