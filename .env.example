# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (AI Studio uses 3000)
PORT="3000"

# MONGODB_URI: Optional MongoDB connection string for persistent storage.
# If omitted, server.ts uses the built-in seeded in-memory + JSON persistence store.
MONGODB_URI=""

# API_BASE_URL: Backend URL used by Android Studio (10.0.2.2 maps to host localhost on Android Emulator)
API_BASE_URL="http://10.0.2.2:3000"

# VITE_API_BASE_URL: Optional external API URL for Capacitor / static mobile builds
VITE_API_BASE_URL=""
